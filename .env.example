# Competition demonstration (Codespace-hosted Streamlit and DataHub)
DATAHUB_MODE=real
DATAHUB_REQUIRED=true
DATAHUB_GMS_URL=http://localhost:8080

# Development fallback (replace the values above):
# DATAHUB_MODE=auto
# DATAHUB_REQUIRED=false
# DATAHUB_GMS_URL=http://localhost:8080

# Explicit offline mode (replace the values above):
# DATAHUB_MODE=mock
# DATAHUB_REQUIRED=false

# The public port-8501 URL is the browser-facing Streamlit application, not
# DATAHUB_GMS_URL. Streamlit Community Cloud cannot use localhost:8080 to reach
# DataHub running in a separate Codespace. The Codespace-hosted Streamlit app
# is the live DataHub-integrated competition demonstration.
